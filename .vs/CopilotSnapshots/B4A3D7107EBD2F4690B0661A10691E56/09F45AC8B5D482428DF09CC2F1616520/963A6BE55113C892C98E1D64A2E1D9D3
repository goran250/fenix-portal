;(function(){
  function initEditForm(){
    const editForm = document.getElementById('events-edit-form');
    if(!editForm) return;

    // When an edit button is clicked open and populate the form
    document.querySelectorAll('.edit-button').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.preventDefault();
        const id = this.getAttribute('data-event-id');
        const name = this.getAttribute('data-event-name');
        const date = this.getAttribute('data-event-date');
        const time = this.getAttribute('data-event-time');
        const location = this.getAttribute('data-event-location');
        const description = this.getAttribute('data-event-description');
        const nbr = this.getAttribute('data-event-nbr');
        const notif = this.getAttribute('data-event-notification');
        const pictureLabel = this.getAttribute('data-event-picture-label') || '';
        const pictureValue = this.getAttribute('data-event-picture-value') || '';
        var f;
        f = editForm.querySelector('input[name="event_id"]'); if(f) f.value = id;
        f = editForm.querySelector('input[name="event_name_edit"]'); if(f) f.value = name;
        f = editForm.querySelector('input[name="event_date_edit"]'); if(f) f.value = date;
        f = editForm.querySelector('input[name="event_time_edit"]'); if(f) f.value = time;
        f = editForm.querySelector('input[name="event_location_edit"]'); if(f) f.value = location;
        f = editForm.querySelector('textarea[name="event_description_edit"]'); if(f) f.value = description;
        f = editForm.querySelector('input[name="event_nbrOfParticipants_edit"]'); if(f) f.value = nbr;
        // populate picture preview label if present
        var picPreview = editForm.querySelector('.event-picture-preview');
        if (!picPreview) {
          picPreview = document.createElement('div');
          picPreview.className = 'event-picture-preview';
          var fileInput = editForm.querySelector('input[type=file][name="event_picture_edit"]');
          if (fileInput && fileInput.parentNode) {
            fileInput.parentNode.appendChild(picPreview);
          } else {
            editForm.appendChild(picPreview);
          }
        }
        if (pictureLabel) {
          picPreview.textContent = 'Nuvarande fil: ' + pictureLabel;
        } else {
          picPreview.textContent = '';
        }
        // ensure hidden existing-field matches the value from the row
        var hiddenExisting = editForm.querySelector('input[name="event_picture_existing"]');
        if (!hiddenExisting) {
          hiddenExisting = document.createElement('input');
          hiddenExisting.type = 'hidden';
          hiddenExisting.name = 'event_picture_existing';
          var fileInput = editForm.querySelector('input[type=file][name="event_picture_edit"]');
          if (fileInput && fileInput.parentNode) {
            fileInput.parentNode.appendChild(hiddenExisting);
          } else {
            editForm.appendChild(hiddenExisting);
          }
        }
        hiddenExisting.value = pictureValue;
        var radios = editForm.querySelectorAll('input[name="event_notification_edit"]');
        radios.forEach(function(r){ r.checked = (r.value === notif); });
        editForm.style.display = 'block';

        var successLabel = document.getElementById('events-success-edit');
        if(successLabel)
          successLabel.remove();

        editForm.scrollIntoView({behavior: 'smooth'});
      });
    });

    // Close button clears and hides
    var close = editForm.querySelector('#events-edit-close');
    if(close) {
      close.addEventListener('click', function(e){
        e.preventDefault();
        var inputs = editForm.querySelectorAll('input');
        inputs.forEach(function(i){
          if(!i.name) return;
          if(i.type === 'hidden'){
            if(i.name === 'event_id') i.value = '';
            return;
          }
          if(i.type === 'radio'){
            i.checked = false;
          } else {
            i.value = '';
          }
        });
 
        editForm.style.display = 'none';
        window.scrollTo(0, 50);
      });
    }
  }
  // Fallback: delegation in case direct handler not attached (works if elements are re-rendered)
  document.addEventListener('click', function(e){
    var target = e.target || e.srcElement;
    if (!target) 
      return;
    if (target.id === 'events-edit-close') {
      var editForm = document.getElementById('events-edit-form');
      if (!editForm) 
        return;
      e.preventDefault();
      var inputs = editForm.querySelectorAll('input');
      inputs.forEach(function(i){
      if(!i.name) 
        return;
      if(i.type === 'hidden'){
        if(i.name === 'event_id') i.value = '';
          return;
        }
        if(i.type === 'radio'){
          i.checked = false;
        } else {
          i.value = '';
        }
      });
      editForm.style.display = 'none';
    }
  }, false);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEditForm);
  } else {
    initEditForm();
  }
  // If the edit form was just saved, PHP will render #events-success-edit
  // Scroll the edit form into view so the user sees the success message
  function scrollToEditFormIfSaved(){
    var success = document.getElementById('events-success-edit');
    var editForm = document.getElementById('events-edit-form');
    if(success && editForm){
      // ensure the form is visible before scrolling
      if(editForm.style.display === 'none'){
        editForm.style.display = 'block';
      }
      // small timeout to allow layout to settle
      setTimeout(function(){
        try
        { 
          editForm.scrollIntoView({ behavior: 'smooth', block: 'start' }); 
        }
        catch(e){ window.scrollTo(0, editForm.offsetTop || 0); }
          // focus first input for convenience
          var first = editForm.querySelector('input, textarea, select');
          if(first) 
            first.focus();
        }, 400);
    }
  }
  // Run the scroll check now and also on DOMContentLoaded in case init ran early
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scrollToEditFormIfSaved);
  } else {
    scrollToEditFormIfSaved();
  }
  // expose a global close function so inline onclick can call it
  window.ollie_close_edit_form = function(){
    var editForm = document.getElementById('events-edit-form');
    if(!editForm) return false;
    var inputs = editForm.querySelectorAll('input');
    inputs.forEach(function(i){
      if(!i.name) 
        return;
      if(i.type === 'hidden'){
        if(i.name === 'event_id') i.value = '';
          return;
      }
      if(i.type === 'radio'){
        i.checked = false;
      } 
      else{
        i.value = '';
      }
    });

    editForm.style.display = 'none';
    return false;
  };
})();

function ShowDescription(id){ 
  var description = document.getElementById(id);
  if(description){
    if(description.style.display === 'none'){
      description.style.display = 'block';
    } 
    else {
      description.style.display = 'none';
    }
  }
}


function ScrollIntoEventView(id){
  var element = document.getElementById(id);
  if(element){
    element.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}
