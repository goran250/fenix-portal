<?php
/**
 * User files upload & list shortcode
 * Shortcode: [uploaded_files]
 * Allows logged-in users to upload files and see/delete their uploads.
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * Return true if GIF file appears to be animated (multiple frames).
 * Scans the file for multiple Graphic Control Extension blocks.
 */
function is_gif_animated( $filename ) {
	if ( ! is_readable( $filename ) ) {
		return false;
	}
	$fp = fopen( $filename, 'rb' );
	if ( ! $fp ) {
		return false;
	}
	$count = 0;
	// Read in chunks until we find more than one GCE (frame) marker or EOF
	while ( ! feof( $fp ) && $count < 2 ) {
		$chunk = fread( $fp, 1024 * 64 );
		if ( $chunk === false || $chunk === '' ) break;
		if ( preg_match_all( '/\x21\xF9\x04/s', $chunk, $m ) ) {
			$count += count( $m[0] );
		}
	}
	fclose( $fp );
	return $count > 1;
}

function shortcode_uploaded_files( $atts ) {
	if ( ! is_user_logged_in() ) {
		return '<p>Please log in to upload and view your files.</p>';
	}

	$user_id = get_current_user_id();
	$messages = array( 'errors' => array(), 'success' => '' );

	// Allowed mime types
	$allowed_mimes = array(
		'application/msword',
		'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
		'text/plain',
		'application/rtf',
		'image/jpeg',
		'image/png',
		'image/webp',
		'image/bmp',
		'image/gif',
		'application/pdf',
		'application/vnd.ms-excel',
		'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
	);

	// Max file size 3 MB
	$max_size = 3 * 1024 * 1024;

	// Handle deletions
	if ( isset( $_GET['delete_file'] ) && isset( $_GET['_uf_nonce'] ) ) {
		if ( ! wp_verify_nonce( wp_unslash( $_GET['_uf_nonce'] ), 'user_files_delete' ) ) {
			$messages['errors'][] = 'Invalid request.';
		} else {
			$delete_id = intval( $_GET['delete_file'] );
			$owner = get_post_field( 'post_author', $delete_id );
			if ( intval( $owner ) === $user_id || current_user_can( 'manage_options' ) ) {
				// Remove attachment and user meta reference
				wp_delete_attachment( $delete_id, true );
				$meta = get_user_meta( $user_id, 'user_files', true );
				if ( is_array( $meta ) ) {
					$meta = array_filter( $meta, function( $v ) use ( $delete_id ) { return intval( $v ) !== intval( $delete_id ); } );
					update_user_meta( $user_id, 'user_files', array_values( $meta ) );
				}
				$messages['success'] = 'File deleted.';
			} else {
				$messages['errors'][] = 'You are not allowed to delete this file.';
			}
		}
	}

	// Handle uploads
	if ( isset( $_POST['user_files_submit'] ) ) {
		if ( ! isset( $_POST['user_files_nonce'] ) || ! wp_verify_nonce( wp_unslash( $_POST['user_files_nonce'] ), 'user_files_action' ) ) {
			$messages['errors'][] = 'Invalid form submission.';
		} else {
			if ( empty( $_FILES['user_files'] ) ) {
				$messages['errors'][] = 'No files uploaded.';
			} else {
				require_once ABSPATH . 'wp-admin/includes/file.php';
				require_once ABSPATH . 'wp-admin/includes/image.php';
				require_once ABSPATH . 'wp-admin/includes/media.php';

				// Normalize multiple uploads
				$files = array();
				if ( is_array( $_FILES['user_files']['name'] ) ) {
					$count = count( $_FILES['user_files']['name'] );
					for ( $i = 0; $i < $count; $i++ ) {
						if ( empty( $_FILES['user_files']['name'][ $i ] ) ) continue;
						$files[] = array(
							'name'     => $_FILES['user_files']['name'][ $i ],
							'type'     => $_FILES['user_files']['type'][ $i ],
							'tmp_name' => $_FILES['user_files']['tmp_name'][ $i ],
							'error'    => $_FILES['user_files']['error'][ $i ],
							'size'     => $_FILES['user_files']['size'][ $i ],
						);
					}
				} else {
					// single file
					$files[] = $_FILES['user_files'];
				}

				foreach ( $files as $file ) {
				if ( intval( $file['error'] ) !== 0 ) {
					$messages['errors'][] = sprintf( 'Upload error for %s (code %d).', esc_html( $file['name'] ), intval( $file['error'] ) );
					continue;
				}
				if ( intval( $file['size'] ) > $max_size ) {
					$messages['errors'][] = sprintf( '%s is too large (max %d MB).', esc_html( $file['name'] ), intval( $max_size / (1024*1024) ) );
					continue;
				}

				// Validate file type and extension using WP helper which attempts content-based checks
				$check = wp_check_filetype_and_ext( $file['tmp_name'], $file['name'] );
				$detected_type = isset( $check['type'] ) ? $check['type'] : '';
				$detected_ext = isset( $check['ext'] ) ? $check['ext'] : '';

				if ( empty( $detected_ext ) || empty( $detected_type ) ) {
					$messages['errors'][] = sprintf( '%s has an unsupported or unrecognized file type.', esc_html( $file['name'] ) );
					continue;
				}

				// Determine category limits
				$cat_label = 'Other files (PDF, DOCX, XLSX, TXT, RTF)';
				$limit = 2 * 1024 * 1024; // default other files 2MB
				// Animated GIFs - 6MB
				if ( $detected_type === 'image/gif' || strtolower( $detected_ext ) === 'gif' ) {
					$cat_label = 'Animated GIFs';
					$limit = 6 * 1024 * 1024;
				} elseif ( in_array( $detected_type, array( 'image/jpeg', 'image/png', 'image/webp', 'image/bmp' ), true ) ) {
					$cat_label = 'Images (JPG, PNG, WEBP, BMP)';
					$limit = 3 * 1024 * 1024;
				}

				if ( intval( $file['size'] ) > $limit ) {
					$messages['errors'][] = sprintf( '%s exceeds the %s limit (%d MB).', esc_html( $file['name'] ), $cat_label, intval( $limit / (1024*1024) ) );
					continue;
				}

				if ( ! in_array( $detected_type, $allowed_mimes, true ) ) {
					$messages['errors'][] = sprintf( '%s has an unsupported file type (%s).', esc_html( $file['name'] ), esc_html( $detected_type ) );
					continue;
				}

					// Move to uploads
					$overrides = array( 'test_form' => false );
					$moved = wp_handle_upload( $file, $overrides );
					if ( isset( $moved['error'] ) ) {
						$messages['errors'][] = sprintf( 'Failed to move %s: %s', esc_html( $file['name'] ), esc_html( $moved['error'] ) );
						continue;
					}

					$filename = $moved['file'];
					$filetype = wp_check_filetype( basename( $filename ), null );
					$attachment = array(
						'post_mime_type' => $filetype['type'],
						'post_title'     => sanitize_file_name( basename( $filename ) ),
						'post_content'   => '',
						'post_status'    => 'inherit',
						'post_author'    => $user_id,
					);

					$attach_id = wp_insert_attachment( $attachment, $filename );
					if ( is_wp_error( $attach_id ) || ! $attach_id ) {
						$messages['errors'][] = sprintf( 'Failed to insert attachment for %s.', esc_html( $file['name'] ) );
						// remove file on disk
						@unlink( $filename );
						continue;
					}

					$attach_data = wp_generate_attachment_metadata( $attach_id, $filename );
					wp_update_attachment_metadata( $attach_id, $attach_data );

					// save reference on user
					$list = get_user_meta( $user_id, 'user_files', true );
					if ( ! is_array( $list ) ) $list = array();
					$list[] = intval( $attach_id );
					update_user_meta( $user_id, 'user_files', array_values( array_unique( $list ) ) );

					$messages['success'] = 'Files uploaded.';
				}
			}
		}
	}

	// Build output
	$out = '';
	if ( ! empty( $messages['errors'] ) ) {
		$out .= '<div class="ppmd-errors"><ul>';
		foreach ( $messages['errors'] as $e ) {
			$out .= '<li>' . esc_html( $e ) . '</li>';
		}
		$out .= '</ul></div>';
	}
	if ( $messages['success'] ) {
		$out .= '<div class="ppmd-success">' . esc_html( $messages['success'] ) . '</div>';
	}

	$out .= '<form method="post" enctype="multipart/form-data" class="user-files-form">';
	$out .= wp_nonce_field( 'user_files_action', 'user_files_nonce', true, false );
	$out .= '<p><label>Select files to upload (multiple allowed):</label><br/><input type="file" name="user_files[]" multiple /></p>';
	$out .= '<p><button type="submit" name="user_files_submit">Upload</button></p>';
	$out .= '</form>';

	// List user's files
	$files = get_user_meta( $user_id, 'user_files', true );
	if ( empty( $files ) || ! is_array( $files ) ) {
		$out .= '<p>No files uploaded yet.</p>';
	} else {
		$out .= '<h3>Your files</h3><ul class="user-files-list">';
		foreach ( $files as $fid ) {
			$fid = intval( $fid );
			$url = wp_get_attachment_url( $fid );
			if ( ! $url ) continue;
			$title = get_the_title( $fid );
			$mime = get_post_mime_type( $fid );
			$date = get_the_date( '', $fid );
			$delete_url = add_query_arg( array( 'delete_file' => $fid, '_uf_nonce' => wp_create_nonce( 'user_files_delete' ) ) );
			$out .= '<li>' . esc_html( $title ) . ' (' . esc_html( $mime ) . ') - <a href="' . esc_url( $url ) . '" target="_blank" rel="noopener">Download</a>';
			$out .= ' ' . '<a href="' . esc_url( $delete_url ) . '" onclick="return confirm(\'Delete this file?\');">Delete</a>';
			$out .= '</li>';
		}
		$out .= '</ul>';
	}

	return $out;
}
add_shortcode( 'uploaded_files', 'shortcode_uploaded_files' );
