<?php
/**
 * Events list & admin add form
 * Shortcode: [events_list]
 * Shows events (Name, Date, Location). Administrators see a form to add events.
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

// Register CPT for events
add_action( 'init', function() {
	$labels = array(
		'name' => 'Events',
		'singular_name' => 'Event',
	);
	$args = array(
		'labels' => $labels,
		'public' => false,
		'show_ui' => false,
		'supports' => array( 'title' ),
		'has_archive' => false,
		'show_in_rest' => false,
	);
	register_post_type( 'event', $args );
} );

function shortcode_events_list( $atts ) {
	$atts = shortcode_atts( array( 'per_page' => 50 ), $atts, 'events_list' );
	
	$out = '<div class="events-list-wrap">';
	
	$messages = array( 'errors' => array(), 'success' => '' );

	// Handle deletion (admin only)
	if ( isset( $_GET['delete_event'] ) ) {
		if ( ! current_user_can( 'manage_options' ) ) {
			$messages['errors'][] = 'Permission denied.';
		} else {
			if ( ! isset( $_GET['_ev_nonce'] ) || ! wp_verify_nonce( wp_unslash( $_GET['_ev_nonce'] ), 'events_delete_action' ) ) {
				$messages['errors'][] = 'Invalid delete request.';
			} else {
				$del_id = intval( $_GET['delete_event'] );
				$post = get_post( $del_id );
				if ( ! $post || $post->post_type !== 'event' ) {
					$messages['errors'][] = 'Event not found.';
				} else {
					wp_delete_post( $del_id, true );
					$messages['success'] = 'Event deleted.';
				}
			}
		}
	}

	// Handle admin form submission

	// Handle admin form submission
	if ( isset( $_POST['events_add_submit'] ) && current_user_can( 'manage_options' ) ) {
		if ( ! isset( $_POST['events_add_nonce'] ) || ! wp_verify_nonce( wp_unslash( $_POST['events_add_nonce'] ), 'events_add_action' ) ) {
			$messages['errors'][] = 'Invalid form submission.';
		} else {
			$name = isset( $_POST['event_name'] ) ? sanitize_text_field( wp_unslash( $_POST['event_name'] ) ) : '';
			$date = isset( $_POST['event_date'] ) ? sanitize_text_field( wp_unslash( $_POST['event_date'] ) ) : '';
			$time = isset( $_POST['event_time'] ) ? sanitize_text_field( wp_unslash( $_POST['event_time'] ) ) : '';
			$nbrOfParticipants = isset( $_POST['event_nbrOfParticipants'] ) ? sanitize_text_field( wp_unslash( $_POST['event_nbrOfParticipants'] ) ) : '';
			$location = isset( $_POST['event_location'] ) ? sanitize_text_field( wp_unslash( $_POST['event_location'] ) ) : '';
			$notification = isset( $_POST['event_notification'] ) ? $_POST['event_notification'] : '';

			if ( $name === '' ) $messages['errors'][] = 'Namn är obligatoriskt.';
			if ( $date === '' ) $messages['errors'][] = 'Datum är obligatoriskt.';
			if ( $time === '' ) $messages['errors'][] = 'Tid är obligatoriskt.';

			// Validate date (expect YYYY-MM-DD)
			if ( $date !== '' ) {
				$d = DateTime::createFromFormat( 'Y-m-d', $date );
				if ( ! $d || $d->format( 'Y-m-d' ) !== $date ) {
					$messages['errors'][] = 'Datum måste vara i formatet YYYY-MM-DD.';
				}
			}

			if ( empty( $messages['errors'] ) ) {
				$postarr = array(
					'post_title' => $name,
					'post_type' => 'event',
					'post_status' => 'publish',
				);
				$post_id = wp_insert_post( $postarr );
				if ( is_wp_error( $post_id ) || ! $post_id ) {
					$messages['errors'][] = 'Misslyckades att skapa eventet.';
				} else {
					update_post_meta( $post_id, 'event_date', $date );
					update_post_meta( $post_id, 'event_time', $time );
					update_post_meta( $post_id, 'event_nbrOfParticipants', $nbrOfParticipants );
					update_post_meta( $post_id, 'event_location', $location );
					update_post_meta( $post_id, 'event_notification', $notification );
					$messages['success'] = 'Event tillagt.';
				}
			}
		}
	}
	// Handle admin edit submission
	if ( ( isset( $_POST['events_edit_submit'] ) || isset( $_POST['event_id'] ) ) && current_user_can( 'manage_options' ) ) {
		if ( ! isset( $_POST['events_edit_nonce'] ) || ! wp_verify_nonce( wp_unslash( $_POST['events_edit_nonce'] ), 'events_edit_action' ) ) {
			$messages['errors'][] = 'Invalid edit submission.';
		} else {
			$edit_id = isset( $_POST['event_id'] ) ? intval( $_POST['event_id'] ) : 0;
			$name = isset( $_POST['event_name_edit'] ) ? sanitize_text_field( wp_unslash( $_POST['event_name_edit'] ) ) : '';
			$date = isset( $_POST['event_date_edit'] ) ? sanitize_text_field( wp_unslash( $_POST['event_date_edit'] ) ) : '';
			$time = isset( $_POST['event_time_edit'] ) ? sanitize_text_field( wp_unslash( $_POST['event_time_edit'] ) ) : '';
			$nbrOfParticipants = isset( $_POST['event_nbrOfParticipants_edit'] ) ? sanitize_text_field( wp_unslash( $_POST['event_nbrOfParticipants_edit'] ) ) : '';
			$location = isset( $_POST['event_location_edit'] ) ? sanitize_text_field( wp_unslash( $_POST['event_location_edit'] ) ) : '';
			$notification = isset( $_POST['event_notification_edit'] ) ? sanitize_text_field( wp_unslash( $_POST['event_notification_edit'] ) ) : '';

			// (debug logging uses error_log; do not add debug messages to errors array here)

			if ( $edit_id <= 0 ) {
				$messages['errors'][] = 'Invalid event id.';
			}
			if ( $name === '' ) $messages['errors'][] = 'Namn är obligatoriskt.';
			if ( $date === '' ) $messages['errors'][] = 'Datum är obligatoriskt.';
			if ( $time === '' ) $messages['errors'][] = 'Tid är obligatoriskt.';

			if ( $date !== '' ) {
				$d = DateTime::createFromFormat( 'Y-m-d', $date );
				if ( ! $d || $d->format( 'Y-m-d' ) !== $date ) {
					$messages['errors'][] = 'Datum måste vara i formatet YYYY-MM-DD.';
				}
			}

			if ( empty( $messages['errors'] ) ) {
				$post = get_post( $edit_id );
				if ( ! $post || $post->post_type !== 'event' ) {
					$messages['errors'][] = 'Event not found.';
				} else {
					// Log intent to update
					error_log( '[events_edit] Updating event ' . $edit_id . ' title=' . $name . ' date=' . $date . ' time=' . $time . ' loc=' . $location . ' nbr=' . $nbrOfParticipants . ' notif=' . $notification );
					// Update post title
					$wp_upd = wp_update_post( array( 'ID' => $edit_id, 'post_title' => $name ), true );
					if ( is_wp_error( $wp_upd ) ) {
						error_log( '[events_edit] wp_update_post failed: ' . $wp_upd->get_error_message() );
					} else {
						error_log( '[events_edit] wp_update_post success for ID ' . $edit_id );
					}
					// Update metas and log results
					$res_date = update_post_meta( $edit_id, 'event_date', $date );
					error_log( '[events_edit] update_post_meta event_date result: ' . var_export( $res_date, true ) );
					$res_time = update_post_meta( $edit_id, 'event_time', $time );
					error_log( '[events_edit] update_post_meta event_time result: ' . var_export( $res_time, true ) );
					$res_nbr = update_post_meta( $edit_id, 'event_nbrOfParticipants', $nbrOfParticipants );
					error_log( '[events_edit] update_post_meta event_nbrOfParticipants result: ' . var_export( $res_nbr, true ) );
					$res_loc = update_post_meta( $edit_id, 'event_location', $location );
					error_log( '[events_edit] update_post_meta event_location result: ' . var_export( $res_loc, true ) );
					// Ensure notification meta is fully replaced to avoid cases where update_post_meta returns false
					// due to encoding or other subtle differences. Delete first, then add/update.
					delete_post_meta( $edit_id, 'event_notification' );
					$res_notif = update_post_meta( $edit_id, 'event_notification', $notification );
					error_log( '[events_edit] update_post_meta event_notification result: ' . var_export( $res_notif, true ) );
					// Clear caches to ensure DB reads are fresh
					if ( function_exists( 'clean_post_cache' ) ) {
						clean_post_cache( $edit_id );
					}
					if ( function_exists( 'wp_cache_flush' ) ) {
						wp_cache_flush();
					}

					// Read back stored meta for debug/UI
					$stored_date = get_post_meta( $edit_id, 'event_date', true );
					$stored_time = get_post_meta( $edit_id, 'event_time', true );
					$stored_loc = get_post_meta( $edit_id, 'event_location', true );
					$stored_nbr = get_post_meta( $edit_id, 'event_nbrOfParticipants', true );
					$stored_notif = get_post_meta( $edit_id, 'event_notification', true );
					// Production success message
					$messages['success'] = 'Event uppdaterat.';
					// preserve saved values to pre-fill the edit form and keep it open
					$edit_saved = array(
						'event_id' => $edit_id,
						'event_name_edit' => $name,
						'event_date_edit' => $date,
						'event_time_edit' => $time,
						'event_location_edit' => $location,
						'event_nbrOfParticipants_edit' => $nbrOfParticipants,
						'event_notification_edit' => $notification,
					);
					error_log( '[events_edit] readback: date=' . $stored_date . ' time=' . $stored_time . ' loc=' . $stored_loc . ' nbr=' . $stored_nbr . ' notif=' . $stored_notif );
				}
			}
		}
	}


	// Admin add form
	if ( current_user_can( 'manage_options' ) ) {
		$out .= '<form method="post" class="events-add-form">';
		$out .= wp_nonce_field( 'events_add_action', 'events_add_nonce', true, false );
		$out .= '<div style="float:left; margin-right: 20px;">
		            <label>Namn:</label>
		            <input name="event_name" required />
				</div>
		        <div style="float:left; margin-right: 20px;">
		          	<label>Datum (YYYY-MM-DD):</label>
					<input name="event_date" type="date" required />
				 </div>
				<div style="float:left; margin-right:  20px;">
		          	<label>Tid</label>
					<input name="event_time" type="time" required />					
				 </div>
				 <div style="float:left; margin-right: 20px;">
					<label>Plats:</label>
					<input name="event_location" />
				</div>
				<div style="float:left; margin-right: 20px;">
		          	<label>Max antal deltagare:</label>
					<input class="event-nbrOfParticipants" name="event_nbrOfParticipants" type="text" />
				 </div>
				 <div style="float:left; margin: 20px 0 0 0; width: 135px;">
				    <label style="display: inline;">Föranmälan:</label>
					<input type="radio" checked name="event_notification" value="Föranmälan" />
					<label style="display: inline; clear:both;">Avanmälan:</label>
					<input style="margin-left: 6px;" type="radio" name="event_notification" value="Avanmälan" />
				</div>
				<div style="clear:both;">
				<button class="submit-button" type="submit" name="events_add_submit" value="1">Lägg till event</button>';
					if ( $messages['success'] ) {
		               $out .= '<div class="events-success">' . esc_html( $messages['success'] ) . '</div>';
					}
				$out .= '</div>
			</form>';
	}

	// Admin edit form (hidden by default)
	if ( current_user_can( 'manage_options' ) ) {
		$out .= '<form method="post" class="events-edit-form" id="events-edit-form" style="display:none; margin-top:20px;">';
		$out .= wp_nonce_field( 'events_edit_action', 'events_edit_nonce', true, false );
		$out .= '<input type="hidden" name="event_id" value="" />';
		$out .= '<div style="float:left; margin-right: 20px;">
					<label>Namn:</label>
					<input name="event_name_edit" required />
				 </div>
				 <div style="float:left; margin-right: 20px;">
					<label>Datum (YYYY-MM-DD):</label>
					<input name="event_date_edit" type="date" required />
				 </div>
				 <div style="float:left; margin-right:  20px;">
					<label>Tid</label>
					<input name="event_time_edit" type="time" required />					
				 </div>
			 	 <div style="float:left; margin-right: 20px;">
					<label>Plats:</label>
					<input name="event_location_edit" />
				 </div>
				 <div style="float:left; margin-right: 20px;">
					<label>Max antal deltagare:</label>
					<input class="event-nbrOfParticipants" name="event_nbrOfParticipants_edit" type="text" />
				 </div>
				 <div style="float:left; margin: 20px 0 0 0; width: 135px;">
					<label style="display: inline;">Föranmälan:</label>
					<input type="radio" name="event_notification_edit" value="Föranmälan" />
					<label style="display: inline; clear:both;">Avanmälan:</label>
					<input style="margin-left: 6px;" type="radio" name="event_notification_edit" value="Avanmälan" />
				 </div>
				$out .= '<div style="clear:both;">';
				$out .= '<button class="submit-button" type="submit" name="events_edit_submit" value="1">Spara ändringar</button>';
				$out .= '<button type="button" id="events-edit-close" class="cancel-button">(X)</button>';
				if ( $messages['success'] ) {
					$out .= '<div class="events-success">' . esc_html( $messages['success'] ) . '</div>';
				}
				$out .= '</div>
			</form>';
	}

	if ( ! empty( $messages['errors'] ) ) {
		$out .= '<div class="events-errors"><ul>';
		foreach ( $messages['errors'] as $e ) {
			$out .= '<li>' . esc_html( $e ) . '</li>';
		}
		$out .= '</ul></div>';
	}

	
	// List events sorted by event_date
	$per_page = intval( $atts['per_page'] );
	$args = array(
		'post_type' => 'event',
		'posts_per_page' => $per_page,
		'meta_key' => 'event_date',
		'orderby' => 'meta_value',
		'order' => 'ASC',
	);
	$q = new WP_Query( $args );
	if ( ! $q->have_posts() ) {
		$out .= '<p>Inga events hittades.</p>';
		return $out;
	}

	$out .= '<div class="events-list">';

				while ( $q->have_posts() ) {	
					$q->the_post();
					$id = get_the_ID();
					$name = get_the_title();	
					$date = get_post_meta( $id, 'event_date', true );
					$time = get_post_meta( $id, 'event_time', true );
					$location = get_post_meta( $id, 'event_location', true );
					$nbrOfParticipants = get_post_meta( $id, 'event_nbrOfParticipants', true );
					$notification = get_post_meta( $id, 'event_notification', true );
					$out .= '<div class="event-item"> 
					            <div>' . esc_html( $name ) . '</div>
								<div>' . esc_html( $date ) . ', kl ' . esc_html( $time ) . '</div>								
								<div>' . esc_html( $location ) . '</div>
								<div>' . esc_html( $nbrOfParticipants ) . ' deltagare</div>
								<div><a href="mailto:susanne.eneroth@pinkdogmedia.se">' . esc_html( $notification ) . '</a></div>
					         </div>';

							if ( current_user_can( 'manage_options' ) ) {
								$del_url = add_query_arg( array( 'delete_event' => $id, '_ev_nonce' => wp_create_nonce( 'events_delete_action' ) ) );
								$out .= ' <a href="' . esc_url( $del_url ) . '" onclick="return confirm(\'Radera detta event?\');" >
											<button class="delete-button" name="events_delete">Radera</button>
										  </a>';
								// Edit button triggers JS to populate and show the edit form
								$out .= ' <button class="edit-button" data-event-id="' . esc_attr( $id ) . '" data-event-name="' . esc_attr( $name ) . '" data-event-date="' . 
								              esc_attr( $date ) . '" data-event-time="' . esc_attr( $time ) . '" data-event-location="' . esc_attr( $location ) . '" data-event-nbr="' . 
								  			  esc_attr( $nbrOfParticipants ) . '" data-event-notification="' . esc_attr( $notification ) . '">Ändra</button>';
							}
				}
				wp_reset_postdata(); 

              $out .= '</div>';

	// Inline script to handle edit button clicks (only for admins)
	if ( current_user_can( 'manage_options' ) ) {
		$out .= "<script>document.addEventListener('DOMContentLoaded', function(){
		  const editForm = document.getElementById('events-edit-form');
		  if(!editForm) return;
		  // capture initial form state so Cancel can restore it
		  function getFormState(){
			var s = {};
			var inputs = editForm.querySelectorAll('input');
			inputs.forEach(function(i){
			  if(!i.name) return;
			  if(i.type === 'radio'){
				if(i.checked) s[i.name] = i.value;
				else if(typeof s[i.name] === 'undefined') s[i.name] = '';
			  } else {
				s[i.name] = i.value;
			  }
			});
			return s;
		  }
		  // store original (empty) state
		  try { editForm.dataset.original = JSON.stringify(getFormState()); } catch(e){}

		  document.querySelectorAll('.edit-button').forEach(function(btn){
			btn.addEventListener('click', function(e){
			  e.preventDefault();
			  const id = this.getAttribute('data-event-id');
			  const name = this.getAttribute('data-event-name');
			  const date = this.getAttribute('data-event-date');
			  const time = this.getAttribute('data-event-time');
			  const location = this.getAttribute('data-event-location');
			  const nbr = this.getAttribute('data-event-nbr');
			  const notif = this.getAttribute('data-event-notification');
			  var f;
			  f = editForm.querySelector('input[name=\"event_id\"]'); if(f) f.value = id;
			  f = editForm.querySelector('input[name=\"event_name_edit\"]'); if(f) f.value = name;
			  f = editForm.querySelector('input[name=\"event_date_edit\"]'); if(f) f.value = date;
			  f = editForm.querySelector('input[name=\"event_time_edit\"]'); if(f) f.value = time;
			  f = editForm.querySelector('input[name=\"event_location_edit\"]'); if(f) f.value = location;
			  f = editForm.querySelector('input[name=\"event_nbrOfParticipants_edit\"]'); if(f) f.value = nbr;
			  // set notification radio
			  var radios = editForm.querySelectorAll('input[name=\"event_notification_edit\"]');
			  radios.forEach(function(r){ r.checked = (r.value === notif); });
			  editForm.style.display = 'block';
			  editForm.scrollIntoView({behavior: 'smooth'});
			});
		  });

			// Cancel button hides and clears the edit form (reset to empty)
		  var cancel = editForm.querySelector('#events-edit-cancel');
		  if(cancel) {
			cancel.addEventListener('click', function(e){
			  e.preventDefault();
			  var inputs = editForm.querySelectorAll('input');
			  inputs.forEach(function(i){
				if(!i.name) return;
				if(i.type === 'hidden'){
				  // clear event_id hidden field explicitly
				  if(i.name === 'event_id') i.value = '';
				  return;
				}
				if(i.type === 'radio'){
				  i.checked = false;
				} else {
				  i.value = '';
				}
			  });
			  editForm.style.display = 'none';
			});
		  }
		});</script>";
	}

	return $out;
}
add_shortcode( 'events_list', 'shortcode_events_list' );
