<?php

add_action( 'wp_enqueue_scripts', 'ollie_child_enqueue_styles' );

/**
 * Enqueue Ollie child theme styles and scripts.
 *
 * @return void
 */
function ollie_child_enqueue_styles(): void {
	wp_enqueue_style( 'ollie-child-style', get_stylesheet_uri(), array( 'ollie' ), wp_get_theme()->get( 'Version' ) );

	// Responsive fixes – laddas sist så den vinner i specificitet
	wp_enqueue_style( 'ollie-child-responsive-fixes', get_stylesheet_directory_uri() . '/responsive-fixes.css', array( 'ollie-child-style' ), wp_get_theme()->get( 'Version' ) );

	// Header scroll effect
	wp_enqueue_script( 'header-scroll', get_stylesheet_directory_uri() . '/header-scroll.js', array(), wp_get_theme()->get( 'Version' ), true );
}


// Registrera Custom Post Type - Medlemmar
function fenix_register_member_cpt() {
    $labels = array(
        'name'               => 'Medlemmar',
        'singular_name'      => 'Medlem',
        'add_new'            => 'Lägg till ny',
        'add_new_item'       => 'Lägg till ny medlem',
        'edit_item'          => 'Redigera medlem',
        'new_item'           => 'Ny medlem',
        'view_item'          => 'Visa medlem',
        'search_items'       => 'Sök medlemmar',
        'not_found'          => 'Inga medlemmar hittades',
        'not_found_in_trash' => 'Inga medlemmar i papperskorgen',
        'menu_name'          => 'Medlemmar',
    );

    $args = array(
        'labels'       => $labels,
        'public'       => true,
        'has_archive'  => false,
        'show_in_rest' => true,
        'supports'     => array( 'title', 'editor', 'thumbnail', 'excerpt', 'custom-fields' ),
        'menu_icon'    => 'dashicons-groups',
        'rewrite'      => array( 'slug' => 'medlemmar' ),
    );

    register_post_type( 'member', $args );
}
add_action( 'init', 'fenix_register_member_cpt' );


// Registrera metafält för Medlemmar
function fenix_register_member_meta() {
    $string_fields = array( 'fenix_name', 'fenix_title', 'fenix_email', 'fenix_phone', 'fenix_address', 'fenix_website' );

    foreach ( $string_fields as $field ) {
        register_post_meta( 'member', $field, array(
            'show_in_rest'  => true,
            'single'        => true,
            'type'          => 'string',
            'auth_callback' => function() {
                return current_user_can( 'edit_posts' );
            },
        ));
    }
}
add_action( 'init', 'fenix_register_member_meta' );

add_shortcode( 'fenix_website_link', function() {
    $url = get_post_meta( get_the_ID(), 'fenix_website', true );
    if ( ! $url ) return '';
    return '<a href="' . esc_url( $url ) . '" target="_blank" class="fenix-website-link">' . esc_html( $url ) . '</a>';
});


// Visa logotyp i arkivet istället för porträtt
function fenix_swap_logo_in_archive( $block_content, $block ) {
    if ( $block['blockName'] !== 'core/post-featured-image' ) {
        return $block_content;
    }

    // På single-sidan matchar queried object ID med post ID i loopen
    if ( (int) get_queried_object_id() === (int) get_the_ID() ) {
        return $block_content;
    }

    $post_id = get_the_ID();
    if ( ! $post_id ) return $block_content;

    $logo_id = get_post_meta( $post_id, 'logo_id', true );
    if ( ! $logo_id ) return $block_content;

    $logo_url = wp_get_attachment_image_url( $logo_id, 'full' );
    if ( ! $logo_url ) return $block_content;

    $block_content = preg_replace( '/(<img[^>]+src=")[^"]*(")/i', '$1' . esc_url( $logo_url ) . '$2', $block_content );
$block_content = preg_replace( '/\s*srcset="[^"]*"/i', '', $block_content );
$block_content = preg_replace( '/\s*sizes="[^"]*"/i', '', $block_content );
$block_content = preg_replace( '/\s*style="[^"]*"/i', '', $block_content );
$block_content = preg_replace( '/\s*width="\d+"/i', '', $block_content );
$block_content = preg_replace( '/\s*height="\d+"/i', '', $block_content );

    return $block_content;
}
add_filter( 'render_block', 'fenix_swap_logo_in_archive', 10, 2 );


