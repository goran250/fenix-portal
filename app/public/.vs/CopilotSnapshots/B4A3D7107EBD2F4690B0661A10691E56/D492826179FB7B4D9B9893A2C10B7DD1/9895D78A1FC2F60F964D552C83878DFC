function ollie_show_company_admin_notice() {
    if ( ! is_admin() ) {
        return;
    }

    // Only show on user edit/profile pages
    if ( ! in_array( basename( filter_input( INPUT_SERVER, 'PHP_SELF', FILTER_SANITIZE_STRING ) ), array( 'user-edit.php', 'profile.php' ), true ) ) {
