    if ( ! $email ) return '';
    return '<a href="mailto:' . antispambot( $email ) . '" class="fenix-email-link">' . antispambot( $email ) . '</a>';
});

// Shortcode för klickbar telefonlänk
add_shortcode( 'fenix_phone_link', function() {
    $phone = get_post_meta( get_the_ID(), 'fenix_phone', true );
    if ( ! $phone ) return '';
    // Rensa bort mellanslag etc för tel:-länken men visa originalet
    $tel = preg_replace( '/[^+0-9]/', '', $phone );
    return '<a href="tel:' . esc_attr( $tel ) . '" class="fenix-phone-link">' . esc_html( $phone ) . '</a>';
});


// Hide Navigation block items with class "admin-only" from non-admins (for FSE / Navigation block)
add_filter( 'render_block', 'fp_filter_navigation_block_admin_only', 10, 2 );
function fp_filter_navigation_block_admin_only( $block_content, $block ) {
    if ( empty( $block['blockName'] ) || $block['blockName'] !== 'core/navigation' ) {
        return $block_content;
    }

    // Let administrators see everything
    if ( current_user_can( 'manage_options' ) ) {
        return $block_content;
    }

    // Navigation block can either include innerBlocks directly, or reference a saved
    // navigation (attrs.ref) which stores its block content in a post. Normalize
    // to $innerBlocks so we can filter consistently.
    $innerBlocks = ! empty( $block['innerBlocks'] ) ? $block['innerBlocks'] : array();

    // If no innerBlocks present but a ref is set, try to load the navigation post
    if ( empty( $innerBlocks ) && ! empty( $block['attrs']['ref'] ) ) {
        $ref = (int) $block['attrs']['ref'];
        $nav_post = get_post( $ref );
        if ( $nav_post && ! empty( $nav_post->post_content ) ) {
            $parsed = parse_blocks( $nav_post->post_content );
            // Debug: log parsed navigation post structure to help find admin-only class
            $debug_parsed = array();
            foreach ( $parsed as $pb ) {
                $debug_parsed[] = array(
                    'blockName' => isset( $pb['blockName'] ) ? $pb['blockName'] : null,
                    'attrs' => isset( $pb['attrs'] ) ? $pb['attrs'] : null,
                    'innerBlocks' => array_map( function( $b ) { return isset($b['blockName']) ? $b['blockName'] : null; }, $pb['innerBlocks'] ?? array() ),
                );
            }
            // Flatten parsed blocks into innerBlocks array
            $innerBlocks = array();
            foreach ( $parsed as $pb ) {
                if ( ! empty( $pb['innerBlocks'] ) ) {
                    $innerBlocks = array_merge( $innerBlocks, $pb['innerBlocks'] );
                } else {
                    $innerBlocks[] = $pb;
                }
            }
        }
    }

    if ( empty( $innerBlocks ) ) {
        return $block_content;
    }

    $filtered = fp_filter_nav_inner_blocks_recursive( $innerBlocks );

    // If nothing changed, return original content
    if ( $filtered === $block['innerBlocks'] ) {
        return $block_content;
    }

    // Render the navigation block with the filtered innerBlocks
    remove_filter( 'render_block', 'fp_filter_navigation_block_admin_only', 10, 2 );
    $new_html = render_block( array(
        'blockName'   => $block['blockName'],
        'attrs'       => isset( $block['attrs'] ) ? $block['attrs'] : array(),
        'innerBlocks' => $filtered,
    ) );
    add_filter( 'render_block', 'fp_filter_navigation_block_admin_only', 10, 2 );

    return $new_html;
}

function fp_filter_nav_inner_blocks_recursive( $innerBlocks ) {
    $out = array();
    foreach ( $innerBlocks as $ib ) {
        // If block has className and contains admin-only, skip it
        $class = isset( $ib['attrs']['className'] ) ? $ib['attrs']['className'] : '';
        if ( is_string( $class ) && strpos( $class, 'admin-only' ) !== false ) {
            continue;
        }

        // Some themes/blocks might put classes on the parent/navigation container
        // or the link object — also check innerHTML for the class as a fallback
        if ( isset( $ib['innerHTML'] ) && strpos( $ib['innerHTML'], 'admin-only' ) !== false ) {
            continue;
        }

        if ( ! empty( $ib['innerBlocks'] ) ) {
            $ib['innerBlocks'] = fp_filter_nav_inner_blocks_recursive( $ib['innerBlocks'] );
        }

        $out[] = $ib;
    }
    return $out;
}
